# ── DataForSEO ────────────────────────────────────────────────────────────────
DATAFORSEO_USERNAME=your_username
DATAFORSEO_PASSWORD=your_password
# `sandbox` hits sandbox.dataforseo.com: correctly-shaped dummy data, never billed.
# Anything else (or unset) hits the live, billed API.
DATAFORSEO_ENV=sandbox

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# ── x402 payments ────────────────────────────────────────────────────────────
# REQUIRED (server). No default: `base` settles real USDC, and defaulting to it
# because a var was unset is how you accidentally move money.
#   base-sepolia -> public facilitator at https://x402.org/facilitator, no keys,
#                   faucet USDC. Use this for development.
#   base         -> Coinbase CDP facilitator, real USDC, needs the CDP keys below.
X402_NETWORK=base-sepolia

# The SAME network, exposed to the browser so the wallet connects to the right
# chain. Must match X402_NETWORK or every payment fails on a chain mismatch.
NEXT_PUBLIC_X402_NETWORK=base-sepolia

# Address that receives USDC. Payments to it are irreversible; check every character.
EVM_ADDRESS=0x...

# Markup over DataForSEO's cost, in basis points. 0 = exact cost pass-through.
PLATFORM_MARKUP_BPS=0

# Optional dedicated RPC for the wallet (else the chain's public endpoint is used).
# NEXT_PUBLIC_RPC_URL=

# ── Coinbase Developer Platform (required only when X402_NETWORK=base) ───────
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# ── Privy auth ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_VERIFICATION_KEY=your_verification_key

# ── Upstash Redis (rate limiting) ────────────────────────────────────────────
# Rate limiting FAILS CLOSED: without Redis, paid endpoints return 503 rather
# than run unmetered. For local development set RATE_LIMIT_DISABLED=1 instead.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# RATE_LIMIT_DISABLED=1

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://based-seo.com

# ── Tab settlement (allowance model) ─────────────────────────────────────────
# Private key of the spender wallet that pulls user allowances via transferFrom.
# Optional: without it, tab settlement is a logged no-op (safe to deploy first).
# This key can only move USDC users have approved, only to EVM_ADDRESS.
# SPENDER_PRIVATE_KEY=0x...
